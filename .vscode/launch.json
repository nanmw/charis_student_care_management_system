{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Windows Desktop)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "args": ["--dart-define=FLUTTER_WEB_USE_SKIA=false"]
    },
    {
      "name": "Flutter (Windows Desktop - Profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "profile",
      "args": ["--dart-define=FLUTTER_WEB_USE_SKIA=false"]
    },
    {
      "name": "Flutter (Windows Desktop - Release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "release",
      "args": ["--dart-define=FLUTTER_WEB_USE_SKIA=false"]
    },
    {
      "name": "Flutter (Windows Desktop - Debug with DevTools)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "args": [
        "--dart-define=FLUTTER_WEB_USE_SKIA=false",
        "--observatory-port=0"
      ],
      "vmServicePort": 0
    }
  ]
}
